<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark counterpart of values/themes.xml's Theme.ContactApp — same style name, so this
         simply overrides windowBackground for the system-dark case. Matches this app's own
         DarkBackground (see Color.kt), not AppCompat's generic dark default, so the brief native
         frame during an Activity recreate() (e.g. right after a language change) shows this app's
         actual dark background instead of a visibly different generic gray. windowLightStatusBar/
         windowLightNavigationBar are flipped to false here — light icons for a dark background —
         same reasoning as the light counterpart's own comment (static theme declaration, not
         only a runtime call, so OEM skins that don't reliably apply the runtime-only version
         still get this right from the moment the window is created). -->
    <style name="Theme.ContactApp" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#FF1A1A1B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
