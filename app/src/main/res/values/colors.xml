<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <!-- Matches Compose's BrandPrimary (ui/theme/Color.kt) — used by uCrop's active-controls tint
         and the classic date-picker dialog theme, neither of which can read the Compose color
         scheme. -->
    <color name="brand_primary">#FF0E51E3</color>
    <!-- Matches Compose's DarkColorScheme.background (ui/theme/Theme.kt) — used by the classic
         date-picker dialog's dark variant, which can't read the Compose color scheme either. -->
    <color name="date_picker_dark_background">#FF121212</color>

    <!-- Native ad views (ads/NativeAdView.kt) - plain Android widgets, not Compose, so they read
         these as resources instead of MaterialTheme.colorScheme. -->
    <color name="light_color_gray">#FF82828E</color>
    <color name="text_title">#FF1B1B24</color>
    <color name="text_des">#FF464555</color>
    <color name="native_ad_card_bg">#FFEBEBEF</color>
    <!-- Contacts' own brand blue, not contactapp's green. -->
    <color name="native_ad_primary">@color/brand_primary</color>
</resources>