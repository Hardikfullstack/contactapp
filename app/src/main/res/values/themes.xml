<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Contacts" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- uCrop's own UCropActivity extends AppCompatActivity and requires a Theme.AppCompat
         descendant to inflate its Toolbar — the plain platform Theme.Contacts above isn't one. -->
    <style name="Theme.Contacts.Crop" parent="Theme.AppCompat.NoActionBar" />

    <!-- The classic android.app.DatePickerDialog reads its style from whatever Context it's built
         with — by default that's the Activity's own Theme.Contacts above, which is hardcoded Light.
         AddContactScreen wraps the dialog's Context in this via ContextThemeWrapper so it always
         shows this same light look, regardless of the app's own in-app Light/Dark/System toggle
         (which only affects the Compose MaterialTheme, not the Activity's XML theme) — a dark
         variant was tried and didn't read well, so this is deliberately not theme-switched. -->
    <style name="Theme.Contacts.DatePicker.Light" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/brand_primary</item>
    </style>
</resources>