<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- DayNight (not plain .Light) so the native window — the brief frame Android draws from
         this XML theme alone, before Compose's own dark/light logic (ContactAppTheme) gets to run
         — resolves to the system's actual night-mode setting instead of always being light. Without
         this, an Activity recreate() (e.g. right after a language change) briefly flashes a light/
         white status bar even in system dark mode, since that split-second native-theme frame has
         no idea the app should be dark. windowBackground is set explicitly to this app's own
         BackgroundLight (see Color.kt) rather than left as AppCompat's generic default — otherwise
         that same brief frame flashes AppCompat's own light color instead of ours, which is just as
         visible a mismatch as the white-in-dark-mode flash this was added to fix (see
         values-night/themes.xml for the dark counterpart). -->
    <style name="Theme.ContactApp" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#FFF7F7F7</item>
    </style>

    <!-- InCallActivity/FakeCallActivity force ContactAppTheme(darkTheme = true) unconditionally —
         their Compose UI is always dark regardless of the system/app light-dark setting. But the
         plain Theme.ContactApp (DayNight) still resolves this native windowBackground to LIGHT
         whenever the system itself is in light mode, since values-night/themes.xml's dark override
         only applies under system dark mode. That light native background then peeks through at
         the very edges Compose doesn't explicitly paint over (e.g. behind a transparent
         edge-to-edge 3-button navigation bar), showing as a stray white strip on an otherwise
         all-dark call screen. Hardcoding this here (no DayNight parent, so it never varies by
         system mode) matches this app's own DarkBackground (see Color.kt) unconditionally. -->
    <style name="Theme.ContactApp.CallScreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#FF1A1A1B</item>
    </style>

    <!-- Android 12+ always shows a system splash screen on cold start, before the first frame is
         drawn. windowSplashScreenBackground is transparent (no green flash before SplashScreen.kt's
         own composable takes over) and windowSplashScreenAnimatedIcon is transparent too (no
         separate small icon drawn). Applied only to MainActivity in the manifest —
         installSplashScreen() (called there) switches to postSplashScreenTheme once the first
         frame is ready. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.ContactApp</item>
    </style>
</resources>