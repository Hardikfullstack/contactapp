<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/ivAvatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvContactName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />

        <!-- Shown instead of tvCallStatus once the call is active — a real Chronometer so the
             elapsed-time count ticks on its own (system-driven), no per-second re-notify needed. -->
        <Chronometer
            android:id="@+id/chronoCallTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:layout_marginTop="1dp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnMute"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_notif_action_neutral"
        android:src="@drawable/ic_notif_mic"
        android:scaleType="center"
        android:padding="7dp"
        android:contentDescription="@string/toggle_mute" />

    <ImageButton
        android:id="@+id/btnSpeaker"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_notif_action_neutral"
        android:src="@drawable/ic_notif_volume_off"
        android:scaleType="center"
        android:padding="7dp"
        android:contentDescription="@string/toggle_speaker" />

    <ImageButton
        android:id="@+id/btnEndCall"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_notif_action_red"
        android:src="@drawable/ic_notif_call_end"
        android:scaleType="center"
        android:padding="7dp"
        android:contentDescription="@string/end_call" />

</LinearLayout>
